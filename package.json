{
  "name": "projectbnb",
  "version": "1.0.0",
  "private": true,
  "description": "BobaBnB, an Airbnb-style web app for boba shops: React and Redux frontend, Express and Sequelize backend",
  "main": "index.js",
  "scripts": {
    "render-postbuild": "npm run build --prefix frontend",
    "install": "npm --prefix backend install backend && npm --prefix frontend install frontend",
    "dev:backend": "npm run start:development --prefix backend",
    "dev:frontend": "npm start --prefix frontend",
    "sequelize": "npm run --prefix backend sequelize",
    "sequelize-cli": "npm run --prefix backend sequelize-cli",
    "start": "npm start --prefix backend",
    "build": "npm run build --prefix backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhoang304/Bobabnb.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/jhoang304/Bobabnb/issues"
  },
  "homepage": "https://github.com/jhoang304/Bobabnb#readme"
}
